# Streamlit Community Cloud 배포 시 앱 설정 > Secrets에 아래 내용을 그대로 붙여넣으세요.
# 로컬 개발 시에는 이 파일을 복사해 .streamlit/secrets.toml로 저장하거나 .env를 사용하세요.
# 이 example 파일만 git에 커밋하고, 실제 secrets.toml은 절대 커밋하지 마세요.

# RAG(SOP 벡터 검색)에 필요합니다. **키를 비우면 RAG까지 함께 죽습니다** —
# 컬렉션 핸들이 임베딩 함수 없이는 열리지 않아 rag_ready=False가 되고 SOP가
# 키워드 폴백으로 떨어집니다(실측 확인). 임베딩 비용은 질의당 $0.00002 수준입니다.
OPENAI_API_KEY = ""

# 배포본은 false로 둡니다 (2026-08-10 결정).
# Community Cloud 앱은 URL을 아는 누구나 접근할 수 있고 로그인 화면에 시연 계정이
# 노출되어 있어, 리포트를 열 때마다 나가는 GPT-4o 호출을 통제할 수단이 없습니다.
# false면 진단이 규칙 기반으로 생성되고 리포트 라벨이 "규칙 기반 진단 (LLM 미사용)"이
# 됩니다. 위의 OPENAI_API_KEY는 그대로 두어야 RAG(SOP)가 동작합니다 — 이 스위치는
# 진단 LLM만 끕니다. AI 진단 시연은 로컬에서 true로 두고 보여줍니다.
DIAGNOSIS_LLM_ENABLED = "false"

# 부팅 요약·진단 결과를 Manage app 로그에서 보려면 INFO 이상이어야 합니다
# (02_architecture.md §6.5).
LOG_LEVEL = "INFO"
