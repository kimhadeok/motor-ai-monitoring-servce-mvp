# Python-generated files
__pycache__/
*.py[oc]
*.egg-info

# Virtual environments
.venv
venv/

# Environment variables
.env

# Ingest completion marker (auto-generated)
.ingest_done
.ingest.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit local secrets (커밋 금지 — .streamlit/secrets.toml.example만 커밋)
.streamlit/secrets.toml

# SQLite WAL/SHM 사이드카 (런타임에 자동 재생성됨)
*.db-wal
*.db-shm

# 시간에 의존하는 데이터만 런타임 생성한다 (app/services/bootstrap.py).
# 데모 텔레메트리는 실행 시각 기준 최근 48시간을 채우므로(app/services/seeding.py) 커밋하면
# 시간이 지나면서 그 구간이 비어버린다. 그래서 부팅마다 새로 만든다.
#
# 반대로 RAG 벡터(data/chroma/)는 시간에 무관한 정적 산출물이라 커밋한다 (2026-08-07 확정).
# Streamlit Community Cloud가 초기화하는 것은 런타임에 쓴 파일이고 커밋된 파일은 체크아웃으로
# 들어오므로, scripts/build_knowledge.py로 한 번 만들어 커밋하면 배포본이 그대로 사용한다.
# 참조 지식(data/knowledge/)과 인제스트 원본(data/rag_sources/)도 커밋 대상이다.
data/app.db