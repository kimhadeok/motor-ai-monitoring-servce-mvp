# Python-generated files
__pycache__/
*.py[oc]
*.egg-info

# Virtual environments
.venv
venv/

# Environment variables
.env

# Ingest completion marker (auto-generated)
.ingest_done
.ingest.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit local secrets (커밋 금지 — .streamlit/secrets.toml.example만 커밋)
.streamlit/secrets.toml

# SQLite WAL/SHM 사이드카 (런타임에 자동 재생성됨)
*.db-wal
*.db-shm

# 시연용 데이터는 앱 부팅 시 런타임 생성한다 (app/services/bootstrap.py).
# Streamlit Community Cloud는 재배포/재시작 시 파일시스템이 초기화되므로 산출물을 커밋해도
# 소용이 없고, 커밋된 데이터는 시간이 지나면 "최근 48시간" 구간이 비어버린다.
# 인제스트 원본인 data/rag_sources/ 만 커밋 대상이다.
data/app.db
data/chroma/