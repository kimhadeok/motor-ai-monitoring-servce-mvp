# Python-generated files
__pycache__/
*.py[oc]
*.egg-info

# Virtual environments
.venv
venv/

# Environment variables
.env

# Ingest completion marker (auto-generated)
.ingest_done
.ingest.lock

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Streamlit local secrets (커밋 금지 — .streamlit/secrets.toml.example만 커밋)
.streamlit/secrets.toml

# SQLite WAL/SHM 사이드카 (런타임에 자동 재생성됨)
*.db-wal
*.db-shm

# 주의: data/app.db, data/chroma/ 는 절대 여기에 추가하지 말 것.
# Streamlit Community Cloud 재배포 시 로컬 파일시스템이 초기화될 수 있어,
# scripts/seed_data.py로 만든 시연용 데이터를 의도적으로 git에 커밋해서 배포한다.